$ORIGIN .
$TTL 60
@ IN SOA ns.root. hostmaster.root. 1 60 60 60 60
@ IN NS ns.root.
ns.root. IN A 127.0.0.1
$ORIGIN test.
$TTL 60
ns IN A 127.0.0.1
www IN A 192.0.2.10
www IN A 192.0.2.11
www IN AAAA 2001:db8::10
alias IN CNAME www.test.
chain IN CNAME alias.test.
loop IN CNAME loop.test.
*.wild IN A 192.0.2.20
child IN NS ns.child.test.
ns.child IN AAAA ::1
external IN NS ns.other.test.
ns.other IN AAAA ::1
